; Engine configuration file.
config_version=5

[application]

config/name="Alleyway"
config/description="Tap-to-trade historical market replay. Watch the tape, tap BUY or SELL."
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Main="*res://src/main.gd"
GameState="*res://src/autoload/game_state.gd"
MarketData="*res://src/autoload/market_data.gd"

[display]

window/size/viewport_width=420
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043137, 0.058824, 0.078431, 1)
